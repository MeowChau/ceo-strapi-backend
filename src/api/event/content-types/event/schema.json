{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Chương trình (Events)",
    "description": "Quản lý sự kiện / chương trình"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "date": {
      "type": "string"
    },
    "desc": {
      "type": "richtext"
    },
    "fontSize": {
      "type": "enumeration",
      "enum": [
        "14px",
        "16px",
        "18px",
        "20px",
        "22px"
      ],
      "default": "16px"
    },
    "fontFamily": {
      "type": "enumeration",
      "enum": [
        "Inter",
        "Roboto",
        "Times New Roman",
        "Arial"
      ],
      "default": "Inter"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imageUrl": {
      "type": "string"
    }
  }
}
