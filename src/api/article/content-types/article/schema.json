{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Tri thức (Articles)",
    "description": "Quản lý bài viết trang Tri Thức"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "desc": {
      "type": "richtext"
    },
    "fontSize": {
      "type": "enumeration",
      "enum": [
        "14px",
        "16px",
        "18px",
        "20px",
        "22px"
      ],
      "default": "16px"
    },
    "fontFamily": {
      "type": "enumeration",
      "enum": [
        "Inter",
        "Roboto",
        "Times New Roman",
        "Arial"
      ],
      "default": "Inter"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imageUrl": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "tags": {
      "type": "string"
    },
    "comments": {
      "type": "integer",
      "default": 0
    }
  }
}
