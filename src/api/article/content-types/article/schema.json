{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Tri thức (Articles)",
    "description": "Quản lý bài viết trang Tri Thức"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "desc": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imageUrl": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "tags": {
      "type": "string"
    },
    "comments": {
      "type": "integer",
      "default": 0
    }
  }
}
